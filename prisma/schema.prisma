// Data model: docs/erd.md. CHECK constraints and the partial unique index on
// product_media are raw SQL in the first migration (Prisma can't express them).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  PRE_ORDER
  READY_STOCK
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT
}

model AdminUser {
  id             String    @id @default(uuid(7)) @db.Uuid
  email          String    @unique @db.VarChar(254)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions       Session[]

  @@map("admin_users")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  adminId   String    @map("admin_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Product {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String         @db.VarChar(80)
  category      String         @db.VarChar(40)
  description   String         @default("") @db.VarChar(500)
  price         Int?
  type          ProductType
  orderDeadline DateTime?      @map("order_deadline") @db.Date
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  media         ProductMedia[]
  orderItems    OrderItem[]
  events        Event[]

  @@index([isActive, sortOrder])
  @@map("products")
}

model ProductMedia {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  publicId    String    @unique @map("public_id") @db.VarChar(255)
  kind        MediaKind
  version     Int
  format      String    @db.VarChar(10)
  width       Int
  height      Int
  bytes       Int
  durationSec Float?    @map("duration_sec") @db.Real
  isMain      Boolean   @default(false) @map("is_main")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_media")
}

model Order {
  id            Int                 @id @default(autoincrement())
  customerName  String              @map("customer_name") @db.VarChar(80)
  customerPhone String              @map("customer_phone") @db.VarChar(15)
  fulfillment   Fulfillment
  address       String?             @db.VarChar(300)
  requestedDate DateTime            @map("requested_date") @db.Date
  note          String?             @db.VarChar(500)
  status        OrderStatus         @default(NEW)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  items         OrderItem[]
  statusChanges OrderStatusChange[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     Int      @map("order_id")
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(80)
  unitPrice   Int?     @map("unit_price")
  quantity    Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusChange {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_changes")
}

model Event {
  id          BigInt    @id @default(autoincrement())
  type        EventType
  productId   String?   @map("product_id") @db.Uuid
  visitorHash String    @map("visitor_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type, productId, createdAt])
  @@map("events")
}

model RateLimit {
  key         String   @db.VarChar(100)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

model PendingDeletion {
  id        String    @id @default(uuid(7)) @db.Uuid
  publicId  String    @unique @map("public_id") @db.VarChar(255)
  kind      MediaKind
  attempts  Int       @default(0)
  lastError String?   @map("last_error") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pending_deletions")
}
