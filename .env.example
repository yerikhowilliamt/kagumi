# Copy to .env (git-ignored) and fill in the Neon DEVELOPMENT branch values only.
# Never put production values in a local file.

# Pooled connection string (host contains "-pooler"). Used by the app at runtime through @prisma/adapter-neon.
DATABASE_URL=

# Direct (unpooled) connection string. Used by the Prisma CLI for migrations.
DIRECT_URL=

# Host of DIRECT_URL (development branch), e.g. ep-xxx.ap-southeast-1.aws.neon.tech.
# The seed and tests/db refuse to run when DATABASE_URL points at any other host.
DEV_DATABASE_HOST=

# Secret of the daily visitor-hash salt (milestone plan D4). Generate your own, e.g. `openssl rand -hex 32`;
# local and Vercel Preview use the development value, Vercel Production its own value. Without it every
# checkout returns the "server" result and the customer falls back to WhatsApp.
TRACKING_SECRET=

# Development admin account, read only by `node scripts/create-admin.ts` (creates or resets it on the
# development branch). ADMIN_PASSWORD needs 12 characters or more. Never Vercel variables.
# CREATE_ADMIN_TARGET and PROD_DATABASE_HOST are not .env names: they go only in .env.prod-admin, the file of the
# production admin account (docs/guide.md §4).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (one account; local, tests and previews upload to kagumi/dev/products). Cloud name: public, inlined into
# client code at build time. API key: server only, sent to the admin's browser with each upload signature. API secret:
# server only, read by src/lib/cloudinary.ts alone; never in a response, a log or client code.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
